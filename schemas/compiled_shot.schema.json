{
  "$defs": {
    "ActionTimeline": {
      "additionalProperties": false,
      "description": "Choreography in source time. `actors` binds roles to asset IDs so motion survives character swaps.",
      "properties": {
        "actors": {
          "additionalProperties": {
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
            "type": "string"
          },
          "description": "role → asset id, e.g. {fighter_A: hero_v4}",
          "minProperties": 1,
          "title": "Actors",
          "type": "object"
        },
        "contacts": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ContactInterval"
          },
          "title": "Contacts",
          "type": "array"
        },
        "duration": {
          "anyOf": [
            {
              "pattern": "^\\s*-?\\d+(\\.\\d+)?(\\s*/\\s*\\d+)?\\s*$",
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "Seconds, exact. Serialized as \"n/d\" (e.g. \"9/10\"); accepts numbers and decimals.",
          "title": "Duration"
        },
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "phases": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Phase"
          },
          "title": "Phases",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "version": {
          "title": "Version",
          "type": "string"
        }
      },
      "required": [
        "id",
        "version",
        "duration",
        "actors"
      ],
      "title": "ActionTimeline",
      "type": "object"
    },
    "CompositeLayer": {
      "additionalProperties": false,
      "properties": {
        "blend": {
          "default": "over",
          "enum": [
            "over",
            "add"
          ],
          "title": "Blend",
          "type": "string"
        },
        "collections": {
          "default": [],
          "description": "view-layer collections enabled for this layer only",
          "items": {
            "type": "string"
          },
          "title": "Collections",
          "type": "array"
        },
        "duration_frames": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Duration Frames"
        },
        "ghost_band_px": {
          "default": 10,
          "maximum": 40,
          "minimum": 1,
          "title": "Ghost Band Px",
          "type": "integer"
        },
        "ghost_colors": {
          "default": [],
          "description": "extra colour rules counted as raw remnants (e.g. ember for an orange-tinted raw weapon)",
          "items": {
            "type": "string"
          },
          "title": "Ghost Colors",
          "type": "array"
        },
        "ghost_fill": {
          "default": "diffuse",
          "description": "diffuse: inpaint from the surrounding pixels; temporal: copy the region from the nearest generated frame where the weapon is not there, aligned by a small shift search (diffusion as fallback)",
          "enum": [
            "diffuse",
            "temporal"
          ],
          "title": "Ghost Fill",
          "type": "string"
        },
        "ghost_keep_objects": {
          "default": [],
          "description": "oc_ids never overwritten by ghost suppression (the actors)",
          "items": {
            "type": "string"
          },
          "title": "Ghost Keep Objects",
          "type": "array"
        },
        "ghost_mode": {
          "default": "outside_core",
          "description": "outside_core (M3-A v1): colour-detected remnants only where the layer alpha < 0.3; under_layer (v2): also under the layer's partial alpha; swept_band (showcase, geometric, for looks where colour cannot separate the weapon from the background): in the authored fast frames, the weapon's authored silhouette in that frame, dilated by ghost_band_px, outside the layer's solid core and outside ghost_keep_objects; the grade gain is then fitted from raw pixels under the layer's solid core in the other frames",
          "enum": [
            "outside_core",
            "under_layer",
            "swept_band"
          ],
          "title": "Ghost Mode",
          "type": "string"
        },
        "ghost_suppression": {
          "default": false,
          "description": "inpaint raw generated remnants of the protected object near its authored path in protected frames",
          "title": "Ghost Suppression",
          "type": "boolean"
        },
        "grade": {
          "default": "none",
          "enum": [
            "none",
            "per_channel_gain"
          ],
          "title": "Grade",
          "type": "string"
        },
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "protected_geometry",
            "effect"
          ],
          "title": "Kind",
          "type": "string"
        },
        "objects": {
          "default": [],
          "description": "oc_ids rendered visible in this layer",
          "items": {
            "type": "string"
          },
          "title": "Objects",
          "type": "array"
        },
        "occlusion": {
          "const": "holdout",
          "default": "holdout",
          "title": "Occlusion",
          "type": "string"
        },
        "order": {
          "default": 0,
          "description": "compositing order (lower first)",
          "title": "Order",
          "type": "integer"
        },
        "protection": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProtectionRule"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "render": {
          "$ref": "#/$defs/LayerRender",
          "default": {
            "holdout_others": true,
            "light_only": null,
            "motion_blur_shutter": 0.5,
            "samples": 64
          }
        },
        "soften_px": {
          "default": 0.0,
          "description": "Gaussian sigma (px) applied to the layer (premultiplied) before compositing, to match the generated video's softness",
          "maximum": 3,
          "minimum": 0,
          "title": "Soften Px",
          "type": "number"
        },
        "trigger": {
          "anyOf": [
            {
              "$ref": "#/$defs/LayerTrigger"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "kind"
      ],
      "title": "CompositeLayer",
      "type": "object"
    },
    "CompositeManifest": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "layers": {
          "items": {
            "$ref": "#/$defs/CompositeLayer"
          },
          "minItems": 1,
          "title": "Layers",
          "type": "array"
        },
        "schema_version": {
          "const": 1,
          "default": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "shot": {
          "title": "Shot",
          "type": "string"
        }
      },
      "required": [
        "id",
        "shot",
        "layers"
      ],
      "title": "CompositeManifest",
      "type": "object"
    },
    "ContactInterval": {
      "additionalProperties": false,
      "description": "An authored contact: e.g. blade-on-blade between fighter_A.sword and fighter_B.sword.",
      "properties": {
        "contact_points": {
          "default": [],
          "description": "e.g. fighter_A.sword.tip",
          "items": {
            "type": "string"
          },
          "title": "Contact Points",
          "type": "array"
        },
        "end": {
          "anyOf": [
            {
              "pattern": "^\\s*-?\\d+(\\.\\d+)?(\\s*/\\s*\\d+)?\\s*$",
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "Seconds, exact. Serialized as \"n/d\" (e.g. \"9/10\"); accepts numbers and decimals.",
          "title": "End"
        },
        "event": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "VFX/audio event triggered by this contact",
          "title": "Event"
        },
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "participants": {
          "description": "role.part references, e.g. fighter_A.sword",
          "items": {
            "type": "string"
          },
          "minItems": 2,
          "title": "Participants",
          "type": "array"
        },
        "required": {
          "default": true,
          "title": "Required",
          "type": "boolean"
        },
        "start": {
          "anyOf": [
            {
              "pattern": "^\\s*-?\\d+(\\.\\d+)?(\\s*/\\s*\\d+)?\\s*$",
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "Seconds, exact. Serialized as \"n/d\" (e.g. \"9/10\"); accepts numbers and decimals.",
          "title": "Start"
        }
      },
      "required": [
        "id",
        "participants",
        "start",
        "end"
      ],
      "title": "ContactInterval",
      "type": "object"
    },
    "GenerationJob": {
      "additionalProperties": false,
      "properties": {
        "backend": {
          "title": "Backend",
          "type": "string"
        },
        "frames": {
          "title": "Frames",
          "type": "integer"
        },
        "overrides": {
          "additionalProperties": {
            "additionalProperties": true,
            "type": "object"
          },
          "description": "node id -> input -> value",
          "title": "Overrides",
          "type": "object"
        },
        "prompt": {
          "title": "Prompt",
          "type": "string"
        },
        "resolution": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Resolution",
          "type": "array"
        },
        "seed": {
          "title": "Seed",
          "type": "integer"
        },
        "steps": {
          "title": "Steps",
          "type": "integer"
        },
        "workflow": {
          "title": "Workflow",
          "type": "string"
        },
        "workflow_sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Workflow Sha256",
          "type": "string"
        }
      },
      "required": [
        "backend",
        "workflow",
        "workflow_sha256",
        "overrides",
        "prompt",
        "seed",
        "steps",
        "resolution",
        "frames"
      ],
      "title": "GenerationJob",
      "type": "object"
    },
    "LayerRender": {
      "additionalProperties": false,
      "description": "How render_layers.py renders a layer: listed objects/collections visible, every other mesh a holdout (it\nstill occludes and casts shadows but renders as transparent), transparent film, optional Blender motion blur.",
      "properties": {
        "holdout_others": {
          "default": true,
          "title": "Holdout Others",
          "type": "boolean"
        },
        "light_only": {
          "anyOf": [
            {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "render a LIGHT pass instead: only these lights on, world and emission off, opaque film, every mesh visible (composited with blend 'add', e.g. an impact flash lighting the scene)",
          "title": "Light Only"
        },
        "motion_blur_shutter": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": 0.5,
          "description": "frames; 0.5 = 180 deg shutter",
          "title": "Motion Blur Shutter"
        },
        "samples": {
          "default": 64,
          "exclusiveMinimum": 0,
          "title": "Samples",
          "type": "integer"
        }
      },
      "title": "LayerRender",
      "type": "object"
    },
    "LayerTrigger": {
      "additionalProperties": false,
      "description": "An effect starts at an ActionTimeline phase boundary (never chosen by the generative model).",
      "properties": {
        "edge": {
          "default": "start",
          "enum": [
            "start",
            "end"
          ],
          "title": "Edge",
          "type": "string"
        },
        "phase": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Phase",
          "type": "string"
        },
        "timeline": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Timeline",
          "type": "string"
        }
      },
      "required": [
        "timeline",
        "phase"
      ],
      "title": "LayerTrigger",
      "type": "object"
    },
    "Phase": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "description": "Actor role, e.g. fighter_A",
          "title": "Actor",
          "type": "string"
        },
        "end": {
          "anyOf": [
            {
              "pattern": "^\\s*-?\\d+(\\.\\d+)?(\\s*/\\s*\\d+)?\\s*$",
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "Seconds, exact. Serialized as \"n/d\" (e.g. \"9/10\"); accepts numbers and decimals.",
          "title": "End"
        },
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "advance",
            "strike",
            "defense",
            "contact",
            "recoil",
            "counterattack",
            "dodge",
            "throw",
            "impact",
            "hold",
            "recovery",
            "idle",
            "other"
          ],
          "title": "Kind",
          "type": "string"
        },
        "start": {
          "anyOf": [
            {
              "pattern": "^\\s*-?\\d+(\\.\\d+)?(\\s*/\\s*\\d+)?\\s*$",
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "Seconds, exact. Serialized as \"n/d\" (e.g. \"9/10\"); accepts numbers and decimals.",
          "title": "Start"
        }
      },
      "required": [
        "id",
        "kind",
        "actor",
        "start",
        "end"
      ],
      "title": "Phase",
      "type": "object"
    },
    "ProcessingPolicy": {
      "additionalProperties": false,
      "description": "How the pipeline treats one semantic object. Composable: appearance and geometry are decided separately.",
      "properties": {
        "appearance": {
          "default": "generative",
          "enum": [
            "generative",
            "deterministic"
          ],
          "title": "Appearance",
          "type": "string"
        },
        "editable": {
          "default": false,
          "description": "a future masked edit may target it (mask must be separable)",
          "title": "Editable",
          "type": "boolean"
        },
        "geometry": {
          "default": "generative",
          "enum": [
            "generative",
            "protected"
          ],
          "title": "Geometry",
          "type": "string"
        },
        "provenance": {
          "default": "",
          "title": "Provenance",
          "type": "string"
        },
        "rule": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rule"
        },
        "timing": {
          "const": "authored",
          "default": "authored",
          "title": "Timing",
          "type": "string"
        }
      },
      "title": "ProcessingPolicy",
      "type": "object"
    },
    "ProtectionRule": {
      "additionalProperties": false,
      "description": "Which output frames a protected-geometry layer replaces. Union of: frames where the authored speed of the\ntracked object (into or out of the frame) is >= authored_speed_widths x its own width (from ground truth),\ndilated by dilate_frames; and frames where the raw generated retention (vs the matched motion-blur reference) is\nbelow raw_retention_below.",
      "properties": {
        "authored_speed_widths": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Authored Speed Widths"
        },
        "dilate_frames": {
          "default": 1,
          "minimum": 0,
          "title": "Dilate Frames",
          "type": "integer"
        },
        "ghost_frames": {
          "default": "unreliable",
          "description": "where swept-band ghost suppression runs: only the authored-fast / low-retention frames, or every protected frame (D3: a long thin weapon is never 'fast' in its own widths)",
          "enum": [
            "unreliable",
            "all"
          ],
          "title": "Ghost Frames",
          "type": "string"
        },
        "include_frames": {
          "default": [],
          "description": "output frames always protected (e.g. the whole shot, so the weapon never switches source mid-shot)",
          "items": {
            "type": "integer"
          },
          "title": "Include Frames",
          "type": "array"
        },
        "raw_retention_below": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "maximum": 1,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Raw Retention Below"
        },
        "track_object": {
          "title": "Track Object",
          "type": "string"
        }
      },
      "required": [
        "track_object"
      ],
      "title": "ProtectionRule",
      "type": "object"
    },
    "QCCheck": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "implemented": {
          "title": "Implemented",
          "type": "boolean"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "params": {
          "additionalProperties": true,
          "default": {},
          "title": "Params",
          "type": "object"
        },
        "provenance": {
          "default": "",
          "title": "Provenance",
          "type": "string"
        },
        "stage": {
          "enum": [
            "preflight",
            "post_generation",
            "final"
          ],
          "title": "Stage",
          "type": "string"
        }
      },
      "required": [
        "id",
        "stage",
        "kind",
        "implemented"
      ],
      "title": "QCCheck",
      "type": "object"
    },
    "ResolvedEvent": {
      "additionalProperties": false,
      "properties": {
        "frame": {
          "minimum": 0,
          "title": "Frame",
          "type": "integer"
        },
        "name": {
          "description": "action.EVENT, e.g. strike.CONTACT",
          "title": "Name",
          "type": "string"
        },
        "time": {
          "anyOf": [
            {
              "pattern": "^\\s*-?\\d+(\\.\\d+)?(\\s*/\\s*\\d+)?\\s*$",
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "Seconds, exact. Serialized as \"n/d\" (e.g. \"9/10\"); accepts numbers and decimals.",
          "title": "Time"
        }
      },
      "required": [
        "name",
        "frame",
        "time"
      ],
      "title": "ResolvedEvent",
      "type": "object"
    },
    "SemanticObject": {
      "additionalProperties": false,
      "properties": {
        "asset": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Asset",
          "type": "string"
        },
        "depth": {
          "default": "depth_pass",
          "enum": [
            "depth_pass",
            "none"
          ],
          "title": "Depth",
          "type": "string"
        },
        "id": {
          "maxLength": 64,
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "enum": [
            "character",
            "weapon",
            "environment_part",
            "effect"
          ],
          "title": "Kind",
          "type": "string"
        },
        "mask_separable": {
          "description": "False when it shares pass indices with another object",
          "title": "Mask Separable",
          "type": "boolean"
        },
        "mask_source": {
          "default": "object_index_pass",
          "enum": [
            "object_index_pass",
            "effect_layer_alpha",
            "none"
          ],
          "title": "Mask Source",
          "type": "string"
        },
        "material_groups": {
          "default": [],
          "description": "finer edit regions (material names)",
          "items": {
            "type": "string"
          },
          "title": "Material Groups",
          "type": "array"
        },
        "material_masks": {
          "additionalProperties": {
            "type": "integer"
          },
          "default": {},
          "description": "per-part masks: part -> material-index pass value (object mask AND material index; empty: no per-part masks)",
          "title": "Material Masks",
          "type": "object"
        },
        "oc_ids": {
          "items": {
            "type": "string"
          },
          "title": "Oc Ids",
          "type": "array"
        },
        "pass_indices": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Pass Indices",
          "type": "array"
        },
        "policy": {
          "$ref": "#/$defs/ProcessingPolicy"
        },
        "protected_layer": {
          "anyOf": [
            {
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Protected Layer"
        }
      },
      "required": [
        "id",
        "kind",
        "asset",
        "oc_ids",
        "mask_separable",
        "policy"
      ],
      "title": "SemanticObject",
      "type": "object"
    },
    "Stage": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.\\-]*$",
          "title": "Id",
          "type": "string"
        },
        "implemented": {
          "title": "Implemented",
          "type": "boolean"
        },
        "in_dry_run": {
          "default": false,
          "title": "In Dry Run",
          "type": "boolean"
        },
        "notes": {
          "default": "",
          "title": "Notes",
