{
  "1": {"class_type": "UNETLoader", "_meta": {"title": "Load LTX-2.5 22B distilled (INT8 ConvRot)"}, "inputs": {"unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "weight_dtype": "default"}},
