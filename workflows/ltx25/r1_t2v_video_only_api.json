{
  "1": {"class_type": "UNETLoader", "_meta": {"title": "Load LTX-2.5 22B distilled (INT8 ConvRot)"},
        "inputs": {"unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "_meta": {"title": "Load Gemma4-12B text encoder (INT8 ConvRot)"},
        "inputs": {"clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors", "type": "ltxv", "device": "default"}},
  "3": {"class_type": "VAELoader", "_meta": {"title": "Load video VAE"},
        "inputs": {"vae_name": "ltx-2.5-video-vae-bf16.safetensors"}},
  "4": {"class_type": "CLIPTextEncode", "_meta": {"title": "Positive prompt (fixed for admission)"},
        "inputs": {"clip": ["2", 0], "text": "A cinematic wide shot of an ancient stone temple courtyard at dusk. A warrior in dark lacquered armor walks toward the camera holding a curved sword. Warm torchlight flickers on the stone pillars, light mist drifts across the ground, and the camera slowly pushes in."}},
  "5": {"class_type": "CLIPTextEncode", "_meta": {"title": "Negative prompt (official default: empty)"},
        "inputs": {"clip": ["2", 0], "text": ""}},
  "6": {"class_type": "LTXVConditioning", "_meta": {"title": "Frame-rate conditioning"},
        "inputs": {"positive": ["4", 0], "negative": ["5", 0], "frame_rate": 24}},
  "7": {"class_type": "EmptyLTXVLatentVideo", "_meta": {"title": "R1 envelope 512x320x49"},
        "inputs": {"width": 512, "height": 320, "length": 49, "batch_size": 1}},
  "8": {"class_type": "RandomNoise", "_meta": {"title": "Seed (comfy_run --seed 8/noise_seed=BASE)"},
        "inputs": {"noise_seed": 1000}},
  "9": {"class_type": "KSamplerSelect", "_meta": {"title": "Official sampler"},
        "inputs": {"sampler_name": "euler_ancestral"}},
  "10": {"class_type": "ManualSigmas", "_meta": {"title": "Official distilled 8-step schedule"},
         "inputs": {"sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"}},
  "11": {"class_type": "CFGGuider", "_meta": {"title": "Official cfg 1 (distilled)"},
         "inputs": {"model": ["1", 0], "positive": ["6", 0], "negative": ["6", 1], "cfg": 1}},
  "12": {"class_type": "SamplerCustomAdvanced", "_meta": {"title": "Denoise"},
         "inputs": {"noise": ["8", 0], "guider": ["11", 0], "sampler": ["9", 0], "sigmas": ["10", 0], "latent_image": ["7", 0]}},
  "13": {"class_type": "VAEDecodeTiled", "_meta": {"title": "Official tiled decode settings"},
         "inputs": {"samples": ["12", 0], "vae": ["3", 0], "tile_size": 512, "overlap": 64, "temporal_size": 128, "temporal_overlap": 32}},
  "14": {"class_type": "CreateVideo", "_meta": {"title": "Video (no audio)"},
         "inputs": {"images": ["13", 0], "fps": 24}},
  "15": {"class_type": "SaveVideo", "_meta": {"title": "Save mp4"},
         "inputs": {"video": ["14", 0], "filename_prefix": "ltx25_r1/ltx25_r1", "format": "mp4"}}
}
